{
  "name": "backend-lulu",
  "version": "1.0.0",
  "description": "Tata Lulu Shop API — Node.js + Express + MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:db": "ts-node src/scripts/check-db.ts",
    "check:errors": "ts-node src/scripts/check-error-handling.ts",
    "check:images": "ts-node src/scripts/check-images.ts",
    "check:customers": "ts-node src/scripts/check-customers.ts",
    "check:monitoring": "ts-node src/scripts/check-monitoring.ts",
    "check:notifications": "ts-node src/scripts/check-notifications.ts",
    "check:orders": "ts-node src/scripts/check-orders.ts",
    "check:performance": "ts-node src/scripts/check-performance.ts",
    "check:purchase-orders": "ts-node src/scripts/check-purchase-orders.ts",
    "check:stock": "ts-node src/scripts/check-stock.ts",
    "check:security": "ts-node src/scripts/check-security.ts",
    "cleanup:images": "ts-node src/scripts/check-images.ts --apply",
    "migrate:sizes": "ts-node src/scripts/migrate-product-sizes.ts",
    "restore:backup": "ts-node src/scripts/restore-backup.ts",
    "render:purchase-order": "ts-node src/scripts/render-purchase-order-sample.ts",
    "start": "node dist/server.js",
    "dev": "node --watch -r ts-node/register src/server.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "test:email": "ts-node src/scripts/test-email.ts"
  },
  "dependencies": {
    "bson": "^6.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "sharp": "^0.35.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/yazl": "^3.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
