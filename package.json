{
  "name": "lulu-shop-monorepo",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "install:all": "pnpm install",
    "dev:front": "pnpm --filter lulu_shop_front dev",
    "dev:back": "pnpm --filter backend-lulu dev",
    "build:front": "pnpm --filter lulu_shop_front build",
    "build:back": "pnpm --filter backend-lulu build",
    "build": "pnpm run build:back && pnpm run build:front",
    "type-check:front": "pnpm --filter lulu_shop_front type-check",
    "type-check:back": "pnpm --filter backend-lulu type-check",
    "type-check": "pnpm run type-check:back && pnpm run type-check:front",
    "lint:front": "pnpm --filter lulu_shop_front lint",
    "test": "pnpm -r --if-present test",
    "seed:back": "pnpm --filter backend-lulu seed"
  }
}
